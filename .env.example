# API Keys
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
VOYAGE_API_KEY=pa-...
COHERE_API_KEY=...

# LLM Settings
DEFAULT_LLM_PROVIDER=openai          # openai | openrouter
DEFAULT_MODEL=gpt-4o                  # model name
OPENROUTER_MODEL=anthropic/claude-sonnet-4
TEMPERATURE=0.0
MAX_TOKENS=2048

# Embedding Settings
DEFAULT_EMBEDDING_MODEL=voyage        # voyage | bge-m3
VOYAGE_MODEL=voyage-3
BGE_MODEL=BAAI/bge-m3

# Vector DB Settings
DEFAULT_VECTOR_DB=qdrant              # qdrant | milvus
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
MILVUS_URL=http://localhost:19530
MILVUS_COLLECTION=documents

# Chunking Settings
CHUNK_SIZE_MIN=256
CHUNK_SIZE_MAX=1024
CHUNK_OVERLAP=128

# NER Settings
NER_MODE=ensemble                     # gliner | spacy | ensemble
GLINER_MODEL=urchade/gliner_multi_pii-v1
SPACY_MODEL=en_core_web_trf
CUSTOM_ENTITY_TYPES=[]

# Search Settings
SEARCH_MODE=hybrid                    # dense | sparse | hybrid
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.3
METADATA_WEIGHT=0.2

# RAG Settings
DEFAULT_RAG_STRATEGY=auto             # simple | crag | srag | advanced | auto
RERANK_TOP_K=20
FINAL_TOP_K=5
ENABLE_HYDE=false
ENABLE_COMPRESSION=true
SRAG_MAX_ITERATIONS=3
DEDUP_SIMILARITY_THRESHOLD=0.95
GROUNDING_THRESHOLD=0.7

# Memory Settings
SHORT_TERM_MEMORY_SIZE=20
CONTEXT_WINDOW_THRESHOLD=0.6
ENABLE_LONG_TERM_MEMORY=true
